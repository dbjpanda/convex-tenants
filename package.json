{
  "name": "@djpanda/convex-tenants",
  "description": "A multi-tenant organization and team management component for Convex with built-in authorization via @djpanda/convex-authz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbjpanda/convex-tenants.git"
  },
  "homepage": "https://github.com/dbjpanda/convex-tenants#readme",
  "bugs": {
    "url": "https://github.com/dbjpanda/convex-tenants/issues"
  },
  "version": "0.4.1",
  "license": "MIT",
  "author": "djpanda",
  "keywords": [
    "convex",
    "component",
    "multi-tenant",
    "organizations",
    "teams",
    "members",
    "invitations",
    "authorization",
    "saas"
  ],
  "type": "module",
  "scripts": {
    "dev": "run-p -r 'dev:*'",
    "dev:backend": "convex dev --typecheck-components",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.{ts,tsx}' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "path-exists .env.local dist || (npm run build && convex dev --once)",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "lint": "eslint .",
    "all": "run-p -r 'dev:*' 'test:watch'",
    "test": "vitest run --typecheck",
    "test:example": "vitest run --typecheck example/tests",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "test:e2e": "cd example && npx playwright test",
    "test:e2e:ui": "cd example && npx playwright test --ui",
    "preversion": "npm ci && npm run build:clean && run-p test lint typecheck",
    "alpha": "npm version prerelease --preid alpha && npm publish --tag alpha && git push --follow-tags",
    "release": "npm version patch && git push --follow-tags",
    "version": "node -e \"const fs=require('fs');const c=fs.readFileSync('CHANGELOG.md','utf8');const h='# Changelog';const entry='## '+process.env.npm_package_version;fs.writeFileSync('CHANGELOG.md',c.replace(h,h+'\\n\\n'+entry))\" && prettier -w CHANGELOG.md && git add CHANGELOG.md"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "@convex-dev/component-source": "./src/react/index.ts",
      "default": "./dist/react/index.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js",
      "default": "./dist/test.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "@djpanda/convex-authz": "^2.3.1",
    "clsx": "^2.0.0",
    "convex": "^1.35.1",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "tailwind-merge": "^2.0.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "clsx": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    }
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@djpanda/convex-authz": "^2.3.1",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "chokidar-cli": "3.0.0",
    "clsx": "^2.1.1",
    "convex": "1.35.1",
    "convex-test": "0.0.47",
    "cpy-cli": "^7.0.0",
    "eslint": "10.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "npm-run-all2": "8.0.4",
    "path-exists-cli": "2.0.0",
    "pkg-pr-new": "^0.0.66",
    "prettier": "3.8.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.1",
    "vite": "8.0.8",
    "vitest": "4.1.4"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.8.0",
    "radix-ui": "^1.4.3"
  }
}
